# ─── Whimsy environment ───────────────────────────────────────────────
# Copy this file to `.env` and fill in a key to enable LIVE event data.
# Without a key, Whimsy runs perfectly on its built-in demo dataset.

# Ticketmaster Discovery API key — free at https://developer.ticketmaster.com
# Read server-side by the Vite dev proxy (vite.config.js); never shipped to
# the browser. Used to fetch real Music / Arts & Theatre / Sports events.
TICKETMASTER_API_KEY=

# Flip to "true" AFTER setting a key above to turn on live API calls.
# Left as "false", the app skips the network and uses the demo dataset.
VITE_TM_ENABLED=false
